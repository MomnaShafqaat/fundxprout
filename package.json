{
  "name": "fundxprout-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm start --workspace=backend",
    "dev": "concurrently -n \"WEB,API\" -c \"cyan,magenta\" \"npm run frontend\" \"npm run backend\"",
    "build": "npm run build --workspace=frontend"
  },
  "dependencies": {
    "@didit-protocol/sdk-web": "^0.2.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "ethers": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1"
  }
}
